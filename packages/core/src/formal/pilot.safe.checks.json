{
  "events": [
    { "type": "START" },
    { "type": "PLAN_READY" },
    { "type": "DRIFT" },
    { "type": "CLEAR" },
    { "type": "HUMAN_PAUSE" },
    { "type": "RESUME" },
    { "type": "COMPLETE" }
  ],
  "never": ["#pilot.failed"],
  "reachable": [
    "#pilot.planning",
    "#pilot.running",
    "#pilot.drift_detected",
    "#pilot.paused_by_human",
    "#pilot.resuming",
    "#pilot.completed"
  ],
  "limit": 1000
}
