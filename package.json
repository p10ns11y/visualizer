{
  "name": "visualizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:critical-flows": "pnpm --filter @visualizer/core test:critical-flows && pnpm --filter @visualizer/web test:critical-flows",
    "test:mbt": "tsx scripts/test-mbt.ts",
    "verify:formal": "tsx scripts/verify-formal.ts",
    "docs:mermaid": "tsx scripts/verify-mermaid.ts",
    "build": "pnpm --filter @visualizer/web build",
    "dev": "pnpm --filter @visualizer/web dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "mermaid": "12.4.0",
    "puppeteer-core": "^24.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
